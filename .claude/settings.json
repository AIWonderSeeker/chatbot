{
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make check-secrets)",
      "Bash(make test-integration)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/mypy *)",
      "Bash(python3 scripts/check_secrets.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.p8)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Read(./.secrets-denylist)",
      "Read(./infra/terraform/*.tfstate*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.py\"",
            "timeout": 60,
            "statusMessage": "Secret scan before git commit/push"
          }
        ]
      }
    ]
  }
}
