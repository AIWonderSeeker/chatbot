# ---------------------------------------------------------------------------
# Copy to .env. Never commit real values. In AWS these come from the task
# definition (plain config) and Secrets Manager (anything marked SECRET).
# ---------------------------------------------------------------------------

# local | dev | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- API service: Bedrock ----
# true = deterministic fake model, no AWS needed
MOCK_BEDROCK=true
AWS_REGION=us-east-1
# Foundation model ID or inference profile ID/ARN (many models require a profile).
BEDROCK_MODEL_ID=REPLACE_WITH_MODEL_OR_INFERENCE_PROFILE_ID
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60
# botocore adaptive retries
BEDROCK_MAX_ATTEMPTS=4
# dedicated thread pool size per task
BEDROCK_MAX_CONCURRENCY=16

# ---- API service: MCP client ----
# compose: http://mcp:8001/mcp
MCP_SERVER_URL=http://localhost:8001/mcp
# SECRET in AWS; must match MCP server
MCP_AUTH_TOKEN=local-dev-token
MCP_TIMEOUT_SECONDS=30
TOOL_ALLOWLIST=get_provider_by_npi,get_provider_claim_summary,get_claim_counts_by_status
TOOL_CACHE_TTL_SECONDS=300

# ---- API service: limits (REQUEST_TIMEOUT must be < ALB idle timeout) ----
MAX_TOOL_ROUNDS=5
MAX_PARALLEL_TOOLS=4
TOOL_TIMEOUT_SECONDS=20
MODEL_CALL_TIMEOUT_SECONDS=45
REQUEST_TIMEOUT_SECONDS=90
MAX_MESSAGE_CHARS=2000
MAX_CONCURRENT_REQUESTS=64

# ---- API service: conversation storage ----
# memory (local only) | dynamodb
CONVERSATION_STORE=memory
DYNAMODB_TABLE=
CONVERSATION_TTL_SECONDS=86400
MAX_HISTORY_TURNS=10

# ---- API service: auth / CORS ----
# none (local only) | alb_oidc
AUTH_MODE=none
# expected signer of x-amzn-oidc-data
ALB_ARN=
# empty = same-origin only
CORS_ALLOWED_ORIGINS=

# ---- MCP server ----
MCP_HOST=0.0.0.0
MCP_PORT=8001
# true = seeded SQLite running the real SQL templates
MOCK_SNOWFLAKE=true
# JSON overrides, see mcp_server/schema_mapping.example.json
SCHEMA_MAPPING_PATH=
# Or inline JSON (takes precedence over the path)
SCHEMA_MAPPING_JSON=
MAX_ROWS=200
STATEMENT_TIMEOUT_SECONDS=30
MAX_DATE_RANGE_DAYS=731
# patient counts 1..10 reported as "<11"; 0 disables
SMALL_CELL_THRESHOLD=11
DB_THREAD_WORKERS=8

# ---- MCP server: Snowflake (read-only service user) ----
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=SVC_NL_ASSISTANT
SNOWFLAKE_ROLE=NL_ASSISTANT_READER
SNOWFLAKE_WAREHOUSE=NL_ASSISTANT_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=CLAIMS_APP
# keypair (recommended) | oauth | password (local experiments only)
SNOWFLAKE_AUTH_METHOD=keypair
# local file path, or...
SNOWFLAKE_PRIVATE_KEY_PATH=
# SECRET: PEM contents injected from Secrets Manager
SNOWFLAKE_PRIVATE_KEY_PEM=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_OAUTH_TOKEN=
SNOWFLAKE_POOL_SIZE=4
SNOWFLAKE_LOGIN_TIMEOUT_SECONDS=15
SNOWFLAKE_NETWORK_TIMEOUT_SECONDS=30
